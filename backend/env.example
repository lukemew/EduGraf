# Configurações do Backend EduGraf
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Configurações de pastas
UPLOAD_DIR=uploads
TEMP_DIR=temp

# Configurações CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configurações de segurança
MAX_FILE_SIZE=10485760  # 10MB em bytes
ALLOWED_EXTENSIONS=.xlsx 